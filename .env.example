# ==============================================================================
# CARRYFORM — Environment Configuration Template (.env.example)
# Commercial Website Template
# ==============================================================================
# Copy this file to .env.local to configure your local development environment:
#   cp .env.example .env.local
#
# NOTE: CARRYFORM operates out-of-the-box in JSON Demonstration Mode without
# requiring any Supabase credentials or environment variables. All variables
# below are OPTIONAL for local development and demonstration.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SITE & CANONICAL METADATA (Optional)
# ------------------------------------------------------------------------------
# Used for OpenGraph tags, Twitter cards, robots.txt, and sitemap generation.
# Default if omitted: https://carryform.in
NEXT_PUBLIC_SITE_URL=https://carryform.in

# ------------------------------------------------------------------------------
# 2. SUPABASE DATABASE & API (Optional — Required only when enabling Supabase mode)
# ------------------------------------------------------------------------------
# When provided, CARRYFORM will automatically verify database connectivity via
# a health check query. If connection succeeds, Supabase Data Provider is used.
# If invalid or unreachable, the application gracefully falls back to JSON data.
#
# Obtain these from: Supabase Dashboard -> Project Settings -> API
#
# [PUBLIC] Your Supabase Project REST Endpoint URL:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# [PUBLIC] Supabase Anonymous / Publishable Key (safe for browser distribution, RLS enforced):
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here

# [SERVER-ONLY] Supabase Service Role Secret Key (OPTIONAL — FOR FUTURE SERVER ADMIN ONLY):
# IMPORTANT SECURITY WARNING:
# - NEVER prefix this with NEXT_PUBLIC_
# - NEVER import or reference this variable in Client Components or browser bundles
# - This key bypasses Row Level Security and must be strictly confined to server endpoints.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# ------------------------------------------------------------------------------
# 3. TEMPORARY DEVELOPMENT ADMIN CREDENTIALS (Optional — Local Development Only)
# ------------------------------------------------------------------------------
# WARNING: These variables provide a development convenience for local demonstration
# only (active in NODE_ENV !== 'production').
# They MUST NOT be used as a production authentication mechanism.
# For production environments, configure Supabase Auth (see docs/SUPABASE_SETUP.md).
#
# Defaults if omitted: username "admin", password "admin"
NEXT_PUBLIC_CARRYFORM_ADMIN_USERNAME=username
NEXT_PUBLIC_CARRYFORM_ADMIN_PASSWORD=password
